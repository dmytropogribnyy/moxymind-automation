{
  "name": "moxymind-quality-automation",
  "version": "1.1.0",
  "private": true,
  "description": "Production-style Playwright and TypeScript quality engineering framework for critical retail UI journeys and REST API contracts.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:all",
    "test:smoke": "playwright test --grep @smoke",
    "test:critical": "playwright test --grep @critical",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:all": "playwright test",
    "test:headed": "playwright test --project=ui --headed",
    "test:runner": "playwright test --ui",
    "test:debug": "cross-env PWDEBUG=1 playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.41",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "zod": "^4.4.3"
  }
}
